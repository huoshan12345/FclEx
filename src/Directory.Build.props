<Project>
  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net8.0;net9.0;net10.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <NoWarn>$(NoWarn);CS1591;CS8500;NU1900</NoWarn>
    <WarningsAsErrors>CS8785</WarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Description>Some basic useful extensions and helpers for C# fundamental class libraries</Description>
    <PackageTags>extensions;helpers</PackageTags>
    <PackageProjectUrl>https://github.com/huoshan12345/FclEx</PackageProjectUrl>
    <RepositoryUrl>https://github.com/huoshan12345/FclEx</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <Authors>huoshan12345</Authors>
    <Copyright>huoshan12345</Copyright>
    <!--NOTE: GetTargetFrameworkVersion('netstandard2.0') is 0.0-->
    <TargetFrameworkVersion>$([MSBuild]::GetTargetFrameworkVersion('$(TargetFramework)', 2))</TargetFrameworkVersion>
    <SuppressTfmSupportBuildWarnings>true</SuppressTfmSupportBuildWarnings>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseFile>LICENSE.TXT</PackageLicenseFile>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
  </PropertyGroup>

  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)..\README.md" Pack="true" PackagePath="\" Visible="false"/>
    <None Include="$(MSBuildThisFileDirectory)..\LICENSE.TXT" Pack="true" PackagePath="\" Visible="false"/>
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>$(AssemblyName).Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <PropertyGroup>
    <BlockedCompilePackages Condition="$(MSBuildProjectName) != 'FclEx.NewtonsoftJson'">Newtonsoft.Json</BlockedCompilePackages>
    <BlockedCompilePackages>$(BlockedCompilePackages);IdentityModel</BlockedCompilePackages>
    <BlockedCompilePackages>;$(BlockedCompilePackages);</BlockedCompilePackages>
  </PropertyGroup>

  <Target Name="RemoveCompileTimeReferences" AfterTargets="ResolvePackageAssets" BeforeTargets="ResolveLockFileReferences">
    <ItemGroup>
      <ResolvedCompileFileDefinitions Remove="@(ResolvedCompileFileDefinitions)"
                                      Condition="$([System.String]::Copy('$(BlockedCompilePackages)').Contains(';%(NuGetPackageId);'))" />
    </ItemGroup>
  </Target>

</Project>