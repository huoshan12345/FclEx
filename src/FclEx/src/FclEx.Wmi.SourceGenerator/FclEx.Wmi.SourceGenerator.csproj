<Project Sdk="Microsoft.NET.Sdk">
  
  <PropertyGroup>
    <!--To fix the error 'The library 'hostpolicy.dll' required to execute the application was not found'-->
    <OutputType>exe</OutputType>
    <TargetFrameworks>net6.0-windows</TargetFrameworks>
    <IsPackable>false</IsPackable>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <NoWarn>RS1035;CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\FclEx\Microsoft\Collections\Extensions\MultiValueDictionary.cs" />
    <Compile Include="..\FclEx\Microsoft\Strings.cs" />
    <Compile Include="..\FclEx.SourceGenerator\FclEx\SourceGenerator\SourceBuilder.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Management" Version="8.0.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.11.0" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" Version="3.11.0" PrivateAssets="all" />
  </ItemGroup>

</Project>
