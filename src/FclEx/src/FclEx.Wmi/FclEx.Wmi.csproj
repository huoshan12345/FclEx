<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net6.0-windows;net7.0-windows</TargetFrameworks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Management" Version="7.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FclEx.Wmi.SourceGenerator\FclEx.Wmi.SourceGenerator.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\FclEx\FclEx.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <ToolName>FclEx.Wmi.SourceGenerator</ToolName>
    <ToolFramework>net6.0-windows</ToolFramework>
    <ToolProjectDir>$(ProjectDir)..\$(ToolName)\</ToolProjectDir>
    <ToolPath>$(ToolProjectDir)bin\$(Configuration)\$(ToolFramework)\$(ToolName).dll</ToolPath>
    <SourceDir>$(ProjectDir)obj\generated\</SourceDir>
  </PropertyGroup>

  <!--https://stackoverflow.com/questions/46675782/how-to-make-an-msbuild-target-that-only-runs-once-instead-of-once-before-target-->
  <Target Name="GenerateCode" BeforeTargets="DispatchToInnerBuilds">
    <ItemGroup>
      <!--MSBuild maintains an item list named FileWrites that contains the files that need to be cleaned.
      This list is persisted to a file inside the obj folder that is referred to as the "clean cache."
      You can place additional values into the FileWrites item list so that they are removed when the project is cleaned up.-->
      <FileWrites Include="$(SourceDir)" />
    </ItemGroup>
    <RemoveDir Directories="$(SourceDir)" />
    <Exec Command="dotnet $(ToolPath) $(SourceDir)">
      <Output TaskParameter="ExitCode" PropertyName="_RunExitCode" />
    </Exec>
    <Error Condition="'$(_RunExitCode)' != '0'" Text="Run $(ToolName) failed" />
    <ItemGroup>
      <Compile Include="$(SourceDir)**\*$(DefaultLanguageSourceExtension)" Exclude="@(Compile)" />
    </ItemGroup>
  </Target>

  <Target Name="IncludeGenerateCode" BeforeTargets="CoreCompile">
    <ItemGroup>
      <Compile Include="$(SourceDir)**\*$(DefaultLanguageSourceExtension)" Exclude="@(Compile)" />
    </ItemGroup>
  </Target>

</Project>
