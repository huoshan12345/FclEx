<Project>
  <PropertyGroup>
    <!--Empty RootNamespace does not work in Directory.Build.props, so put it in this file as a workaround-->
    <RootNamespace></RootNamespace>
  </PropertyGroup>  

  <ItemGroup>
    <_ExcludeFclExUsing Include="FclEx" />
    <_ExcludeFclExUsing Include="FclEx.SourceGenerator" />
    <_ExcludeFclExUsing Include="FclEx.Wmi.SourceGenerator" />
  </ItemGroup>

  <ItemGroup Condition="!@(_ExcludeFclExUsing->AnyHaveMetadataValue('Identity', '$(ProjectName)'))">
    <Compile Include="$(ProjectDir)..\..\..\FclEx\src\FclEx\FclExUsing.cs" />
  </ItemGroup>
  
</Project>