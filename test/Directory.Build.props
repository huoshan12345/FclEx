<Project>
  <PropertyGroup>
    <IsWindows Condition="'$(OS)' == 'Windows_NT'">true</IsWindows>
    <TargetFrameworkVersion>$([MSBuild]::GetTargetFrameworkVersion('$(TargetFramework)', 2))</TargetFrameworkVersion>
  </PropertyGroup>

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <NoWarn>$(NoWarn);xUnit2013;xUnit1041;NU1901;NU1902;NU1903;NU1904;xUnit1051;AD0001;CS8500;NU1900</NoWarn>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <TargetFrameworks Condition="'$(IsWindows)' == 'true'">$(TargetFrameworks);net472;</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <SuppressTfmSupportBuildWarnings>true</SuppressTfmSupportBuildWarnings>
    <SuppressTfmSupportBuildErrors>true</SuppressTfmSupportBuildErrors>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <EnableNETAnalyzers>False</EnableNETAnalyzers>
    <AnalysisLevel>none</AnalysisLevel>
    <RunAnalyzersDuringBuild>false</RunAnalyzersDuringBuild>
    <RunAnalyzersDuringLiveAnalysis>false</RunAnalyzersDuringLiveAnalysis>
    <RunAnalyzers>false</RunAnalyzers>
  </PropertyGroup>

  <PropertyGroup>
    <!--<DefineConstants Condition="'$(TargetFramework)' == 'net10.0'">$(DefineConstants);DISABLE_NPGSQL</DefineConstants>-->
    <DefineConstants Condition="'$(TargetFramework)' == 'net10.0'">$(DefineConstants);DISABLE_MYSQL</DefineConstants>
  </PropertyGroup>

  <PropertyGroup>
    <_RootDir>$(MSBuildThisFileDirectory)..\</_RootDir>
    <VSTestLogger>trx%3bLogFileName=$(MSBuildProjectName).trx</VSTestLogger>
  </PropertyGroup>

  <Target Name="ComputeCustomTestResultsDirectory" BeforeTargets="VSTest">
    <PropertyGroup>
      <VSTestResultsDirectory>$([System.IO.Path]::Combine($(_RootDir), TestResults, $(Configuration), $(TargetFramework), $(PlatformTarget)))</VSTestResultsDirectory>
    </PropertyGroup>
  </Target>

  <ItemGroup>
    <Content Include="appsettings*.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Include="TestData\**\*.*">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <__DisableParallel Include="FclEx.Core.Tests" />
    <__DisableParallel Include="FclEx.Xunit.Tests" />
    <__DisableParallel Include="FclEx.Xunit.v3.Tests" />
    <AssemblyAttribute Include="Xunit.TestFramework"
                       Condition="@( __DisableParallel->AnyHaveMetadataValue('Identity', '$(MSBuildProjectName)')) != 'true' ">
      <_Parameter1>Meziantou.Xunit.v3.ParallelTestFramework</_Parameter1>
      <_Parameter1_TypeName>System.Type</_Parameter1_TypeName>
    </AssemblyAttribute>
  </ItemGroup>

  <!--<Target Name="Print" BeforeTargets="CoreCompile">
    <Message Importance="High"
             Text="IsInList: @( __DisableParallel->AnyHaveMetadataValue('Identity', '$(MSBuildProjectName)') )" />
  </Target>-->

  <PropertyGroup Condition="$(TargetFramework.StartsWith('net4'))">
    <OutputType Condition="'$(IsTestProject)' != 'false'">Exe</OutputType>
    <Prefer32Bit>false</Prefer32Bit>
    <PlatformTarget>AnyCPU</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="$(MSBuildThisFileDirectory)..\src\FclEx.Core\FclExUsings.cs" />
  </ItemGroup>

</Project>