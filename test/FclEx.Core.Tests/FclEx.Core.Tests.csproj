<Project Sdk="Microsoft.NET.Sdk">
  <ItemGroup>
    <ProjectReference Include="..\..\src\FclEx.Xunit.v3\FclEx.Xunit.v3.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" />
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="Microsoft.Testing.Extensions.TrxReport" />
    <PackageReference Include="Moq" />
    <PackageReference Include="Xunit.v3.Priority" />
    <PackageReference Include="morelinq" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <!--xunit.v3 is required to discover tests when a test project is running using dotnet command.-->
    <PackageReference Include="xunit.v3" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="TestData\ResourceOne\SharedResource.txt" />
    <EmbeddedResource Include="TestData\ResourceTwo\SharedResource.txt" />
  </ItemGroup>
  <ItemGroup Condition="$(TargetFramework.StartsWith('net4'))">
    <Reference Include="System.IO.Compression" />
    <PackageReference Include="System.Text.Encoding.CodePages" />
  </ItemGroup>
  <ItemGroup>
    <None Include="xunit.runner.debug.json" CopyToOutputDirectory="PreserveNewest" TargetPath="xunit.runner.json" Condition="'$(Configuration)' == 'Debug'" />
    <None Include="xunit.runner.release.json" CopyToOutputDirectory="PreserveNewest" TargetPath="xunit.runner.json" Condition="'$(Configuration)' == 'Release'" />
  </ItemGroup>
</Project>
