<Project>
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>latest</LangVersion>
    <SupportOracle>false</SupportOracle>
    <IncludeNet90>true</IncludeNet90>
    <TargetFrameworkVersion>$([MSBuild]::GetTargetFrameworkVersion('$(TargetFramework)', 2))</TargetFrameworkVersion>
    <IsWindows>$([MSBuild]::IsOSPlatform('Windows'))</IsWindows>
    <Is64BitOS>$([System.Environment]::Is64BitOperatingSystem)</Is64BitOS>
  </PropertyGroup>
  <PropertyGroup Condition="$([MSBuild]::VersionGreaterThanOrEquals($(TargetFrameworkVersion), 6.0))">
    <SupportOracle>true</SupportOracle>
    <DefineConstants>$(DefineConstants);SUPPORT_ORACLE</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="$(IsWindows)">
    <IncludeNet90>false</IncludeNet90>
  </PropertyGroup>
</Project>